# Variabili da impostare nella risorsa Coolify, mai nel repository

# Generata una volta con: php artisan key:generate --show
APP_KEY=

# Nome del container MySQL del progetto infra (lo assegna Coolify)
DB_HOST=

# Password dell'utente dedicato all'applicazione sul MySQL condiviso
DB_PASSWORD=

# Nome che Coolify assegna al servizio redis di questa risorsa (redis-<uuid>)
REDIS_HOST=
